# Copy to .env and fill in. Never commit .env.

# Neon Postgres connection string (from the Neon console, "Connection string").
# postgresql:// URLs are rewritten to use the psycopg v3 driver automatically.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Public base URL of the deployed app (Render), used to register Telegram webhooks.
# Leave empty locally: the bot then runs in polling mode.
PUBLIC_BASE_URL=

# Secret path segment for Telegram webhooks (any long random string).
WEBHOOK_SECRET=change-me

# Admin dashboard basic-auth.
ADMIN_USER=admin
ADMIN_PASSWORD=change-me

# Groq (free tier). Keep LLM_ENABLED=false unless actively testing.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
LLM_ENABLED=false
LLM_MAX_CALLS_PER_MINUTE=20
LLM_MAX_CALLS_PER_DAY=500

# One token per tenant bot. The env var name is set in tenants/<slug>/tenant.yaml (bot_token_env).
SHOPKART_BOT_TOKEN=
